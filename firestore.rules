rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }

    // Administrador: o único que aprova e remove professores.
    // O e-mail precisa ser o mesmo de window.GABARITO_ADMIN em js/config.js
    function admin() {
      return logado() && request.auth.token.email_verified == true
             && request.auth.token.email.lower() in ['andersonserafimcpv@gmail.com'];
    }

    // Professor aprovado pelo administrador (aba Acessos)
    function aprovado() {
      return admin() || (logado()
        && exists(/databases/$(database)/documents/gab_acessos/$(request.auth.uid))
        && get(/databases/$(database)/documents/gab_acessos/$(request.auth.uid)).data.status == 'aprovado');
    }

    // Pedidos de acesso: cada professor só cria o próprio, como "pendente".
    // Só o administrador vê todos e muda o status (aprovado, recusado, removido).
    match /gab_acessos/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow create: if logado() && request.auth.uid == uid
                    && request.resource.data.status == 'pendente'
                    && request.resource.data.dono == uid
                    && request.resource.data.keys().hasOnly(['uid', 'dono', 'nome', 'email', 'foto', 'status', 'pedidoEm']);
      allow update, delete: if admin();
    }

    // Dados da escola (cabeçalho das folhas), um por professor
    match /gab_perfis/{uid} {
      allow read, write: if aprovado() && request.auth.uid == uid;
    }

    // Turmas, avaliações, notas, timbrados e pastas (todas as outras coleções gab_…):
    // só professores aprovados, e cada um só vê e altera o que é dele
    match /{col}/{id} {
      function colecaoDeDados() { return col.matches('gab_.*') && col != 'gab_perfis' && col != 'gab_acessos'; }
      allow read, delete: if colecaoDeDados() && aprovado()
                          && resource.data.dono == request.auth.uid;
      allow create: if colecaoDeDados() && aprovado()
                    && request.resource.data.dono == request.auth.uid;
      allow update: if colecaoDeDados() && aprovado()
                    && resource.data.dono == request.auth.uid
                    && request.resource.data.dono == request.auth.uid;
    }
  }
}
